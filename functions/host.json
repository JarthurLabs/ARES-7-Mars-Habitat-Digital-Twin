{
  "version": "2.0",
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      },
      "enableLiveMetricsFilters": true
    }
  },
  "extensions": {
    "eventGrid": {
      "maxBatchSize": 1,
      "preferredBatchSizeInKilobytes": 64
    }
  }
}
