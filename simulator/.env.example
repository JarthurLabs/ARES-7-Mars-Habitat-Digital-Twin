# Use an individual IoT Hub device credential, never an IoT Hub owner connection string.
# Do not commit a real value.
IOTHUB_DEVICE_CONNECTION_STRING=

# Optional. A random UUID is generated when omitted.
ARES7_SCENARIO_RUN_ID=

# Cloud cadence. 12 seconds keeps state transitions visible in 3D Scenes Studio.
ARES7_INTERVAL_SECONDS=12
# Optional longer hold after critical tick 4 for the external human approval workflow.
ARES7_APPROVAL_GATE_DELAY_SECONDS=12
